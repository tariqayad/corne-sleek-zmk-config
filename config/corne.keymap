#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        delete {
            bindings = <&kp DELETE>;
            key-positions = <10 11>;
        };

        bt1 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <25 1>;
        };

        bt2 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <26 2>;
        };

        bt3 {
            bindings = <&bt BT_SEL 2>;
            key-positions = <27 3>;
        };

        fn_audio_out {
            bindings = <&macro_audioout>;
            key-positions = <11 40>;
        };

        fn_no_camera {
            bindings = <&macro_no_camera>;
            key-positions = <10 40>;
        };

        fn_mute {
            bindings = <&macro_mute>;
            key-positions = <9 40>;
        };

        home {
            bindings = <&kp HOME>;
            key-positions = <7 8>;
        };

        end {
            bindings = <&kp END>;
            key-positions = <31 32>;
        };

        righShift {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <19 20>;
        };
    };

    macros {
        macro_audioout: macro_audioout {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(LG(V))>;
            label = "MACRO_AUDIOOUT";
        };

        macro_mute: macro_mute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(LS(M))>;
            label = "MACRO_MUTE";
        };

        macro_no_camera: macro_no_camera {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(LS(O))>;
            label = "MACRO_NO_CAMERA";
        };

        macro_base_layer: macro_base_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &to 0>;
            label = "MACRO_BASE_LAYER";
        };
    };

    behaviors {
        layerTapHold: layerTapHold {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYERTAPHOLD";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        tapKeyPressHoldMomLayer: tapKeyPressHoldMomLayer {
            compatible = "zmk,behavior-hold-tap";
            label = "TAPKEYPRESSHOLDMOMLAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp TAB                &kp Q           &kp W  &kp E     &kp R  &kp T        &kp Y                  &kp U              &kp I                &kp O    &kp P     &kp BSPC
&mt LEFT_SHIFT ESCAPE  &kp A           &kp S  &kp D     &kp F  &kp G        &kp H                  &kp J              &kp K                &kp L    &kp SEMI  &kp SQT
&kp LCTRL              &mt LEFT_ALT Z  &kp X  &kp C     &kp V  &kp B        &kp N                  &kp M              &kp COMMA            &kp DOT  &kp FSLH  &mo 3
                                              &kp LGUI  &mo 2  &kp SPACE    &mt RIGHT_SHIFT SPACE  &layerTapHold 1 1  &mt RIGHT_ALT ENTER
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Num Arrows";
            bindings = <
&kp TAB    &kp SLASH        &kp NUMBER_7  &kp N8        &kp N9        &kp MINUS     &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp UP          &mt LEFT_BRACKET KP_LEFT_PARENTHESIS  &mt RIGHT_BRACKET KP_RIGHT_PARENTHESIS  &trans
&kp LCTRL  &kp KP_MULTIPLY  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS      &kp HOME        &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT                             &kp END                                 &kp PAGE_UP
&kp LSHFT  &kp NUMBER_0     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD    &none           &none            &none           &none                                 &kp K_CONTEXT_MENU                      &kp PAGE_DOWN
                                          &kp LGUI      &to 0         &kp SPACE     &kp ENTER       &tog 2           &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Special";
            bindings = <
&kp TAB  &kp EXCL  &kp AT  &kp HASH  &kp DLLR      &kp PRCNT    &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR       &kp DEL
&trans   &kp F1    &kp F2  &kp F3    &kp QUESTION  &kp TILDE    &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT  &kp PIPE       &kp GRAVE
&trans   &kp F4    &kp F5  &kp F6    &trans        &trans       &kp UNDER  &kp PLUS   &kp LBRC         &kp RBRC  &kp BACKSLASH  &kp TILDE
                           &kp LGUI  &to 1         &kp SPACE    &trans     &tog 3     &trans
            >;
        };

        functions {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4   &kp F5     &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &kp F6  &kp F7  &kp F8  &kp F9   &kp F10    &trans  &trans  &kp F5  &kp F5   &trans   &trans
&trans  &trans  &trans  &trans  &kp F11  &kp F12    &trans  &trans  &trans  &trans   &trans   &trans
                        &trans  &to 2    &trans     &trans  &tog 6  &trans
            >;

            label = "Functions";
        };

        numpad {
            bindings = <
&trans  &kp N7  &kp N8  &kp N9  &kp MINUS  &kp KP_DIVIDE      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N4  &kp N5  &kp N6  &kp PLUS   &kp KP_MULTIPLY    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N0  &kp N1  &kp N3  &kp DOT    &kp KP_EQUAL       &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &to 3      &trans             &trans  &to 5   &trans
            >;

            label = "Num Pad";
        };

        colemakdh {
            bindings = <
&trans  &kp Q  &kp W  &kp F   &kp P  &kp G        &kp J      &kp L  &kp U      &kp Y    &trans    &trans
&trans  &kp A  &kp R  &kp S   &kp T  &kp D        &kp H      &kp N  &kp E      &kp I    &kp O     &trans
&trans  &kp Z  &kp X  &kp C   &kp V  &kp B        &kp K      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &trans
                      &trans  &to 4  &kp SPACE    &kp ENTER  &to 6  &trans
            >;

            label = "Colemak-Dh";
        };

        config {
            bindings = <
&bootloader  &kp CLCK      &trans        &trans        &trans        &trans          &none           &none            &none      &none  &none  &none
&trans       &trans        &trans        &trans        &trans        &trans          &none           &kp C_VOLUME_UP  &none      &none  &none  &none
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp LEFT_ARROW  &kp C_VOL_DN     &kp RIGHT  &none  &none  &to 5
                                         &trans        &to 0         &trans          &trans          &trans           &trans
            >;

            label = "Config";
        };
    };
};
